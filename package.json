{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest --exclude \"e2e/**\"",
    "test:run": "vitest run --exclude \"e2e/**\"",
    "test:rules": "vitest run src/utils/checkInCatchUpRules.test.js",
    "test:e2e": "playwright test",
    "db:push": "npx supabase db push",
    "deploy:coach": "npx supabase functions deploy generate-weekly-coach-review",
    "deploy:adjustment": "npx supabase functions deploy generate-plan-adjustment",
    "loc": "powershell -NoProfile -Command \"$ext='.js','.jsx','.ts','.tsx','.css','.sql'; $files=Get-ChildItem -Recurse -File | Where-Object { $ext -contains $_.Extension -and $_.FullName -notmatch '\\\\node_modules\\\\|\\\\dist\\\\|\\\\coverage\\\\' }; $lines=($files | Get-Content | Measure-Object -Line).Lines; Write-Host ($files.Count.ToString() + ' files / ' + $lines.ToString() + ' LOC')\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.0"
  }
}
